# Copy to .env next to docker-compose.yml and fill in. Never commit .env.
# Generate secrets with:  openssl rand -hex 32
POSTGRES_PASSWORD=
PAYLOAD_SECRET=

# Public addresses (HTTPS, handled by the host's nginx)
SITE_URL=https://wokin.vn
ADMIN_URL=https://admin.wokin.vn

# Local ports the host's nginx proxies to (only reachable from the VPS itself).
# Uncommon on purpose so they do not clash with other apps on the VPS (3000/8080 are often taken).
WEB_PORT=47311
ADMIN_PORT=47310
