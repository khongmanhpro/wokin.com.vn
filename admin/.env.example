DATABASE_URL=postgresql://wokin_payload:[REDACTED]@127.0.0.1:54329/wokin_payload
PAYLOAD_SECRET=[REDACTED]
STORAGE_ADAPTER=local
PAYLOAD_PUBLIC_SERVER_URL=https://admin.local.test
CONTACT_ALLOWED_ORIGINS=https://wokin.vn
PAYLOAD_SEPARATION_OF_DUTIES=true
POSTGRES_PASSWORD=[REDACTED]

# Required only when STORAGE_ADAPTER=s3.
# S3_BUCKET=[REDACTED]
# S3_REGION=[REDACTED]
# S3_ENDPOINT=[REDACTED]
# S3_ACCESS_KEY_ID=[REDACTED]
# S3_SECRET_ACCESS_KEY=[REDACTED]

# "Xuất bản website" (admin → static website on the same server). Leave WEBSITE_PUBLISH_DIR unset to disable.
# nginx serves <WEBSITE_PUBLISH_DIR>/current; each publish adds releases/<id>/ and switches that symlink.
# WEBSITE_PUBLISH_DIR=/var/www/wokin
# WEBSITE_DIR=/srv/wokin.com.vn          # website checkout; defaults to the folder above admin/
# WEBSITE_PUBLIC_URL=https://wokin.vn
# MEDIA_UPLOAD_DIR=/srv/wokin-media       # images uploaded in the admin (copied into each publish)
