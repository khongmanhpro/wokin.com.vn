# Security headers for the static Next.js export served by Apache/LiteSpeed.
# Requires mod_headers (or the LiteSpeed-compatible Header directive).
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Exact legacy-page redirects. The default Apache behavior preserves the
  # original query string; anchored sources prevent prefix matches and loops.
  RewriteRule ^about/?$ /gioi-thieu/ [R=301,L,NE]
  RewriteRule ^contact/?$ /lien-he/ [R=301,L,NE]
  RewriteRule ^distributors/?$ /nha-phan-phoi/ [R=301,L,NE]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), geolocation=(), microphone=(), payment=(), usb=()"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; img-src 'self' data:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'; frame-src 'none'"

  # HSTS is intentionally disabled. Enable only after production and every
  # affected hostname are HTTPS-only; stage max-age as described in DEPLOYMENT.md.
  # Header always set Strict-Transport-Security "max-age=300"
</IfModule>
