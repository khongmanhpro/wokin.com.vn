{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wokin.com.vn/contracts/catalog-snapshot.schema.json",
  "title": "WOKIN static catalog publish snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "snapshotId", "products", "categories", "media", "checksum"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "snapshotId": { "type": "string", "pattern": "^poc-[a-f0-9]{16}$" },
    "checksum": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "categories": {
      "type": "array",
      "items": { "$ref": "#/$defs/category" }
    },
    "media": {
      "type": "array",
      "items": { "$ref": "#/$defs/media" }
    },
    "products": {
      "type": "array",
      "items": { "$ref": "#/$defs/product" }
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "nameVi", "slug"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "nameVi": { "type": "string", "minLength": 1 },
        "slug": { "$ref": "#/$defs/slug" }
      }
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "alt"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?![\\\\/])(?![A-Za-z][A-Za-z0-9+.-]*:)(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+$"
        },
        "alt": { "type": "string", "minLength": 1 }
      }
    },
    "specification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "value"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "value": { "type": "string", "minLength": 1 },
        "unit": { "type": "string", "minLength": 1 }
      }
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "legacySourceId", "sku", "nameVi", "slugVi", "categoryIds", "mediaIds", "specifications"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "legacySourceId": { "type": "integer" },
        "sku": { "type": ["string", "null"] },
        "nameVi": { "type": "string", "minLength": 1 },
        "slugVi": { "$ref": "#/$defs/slug" },
        "categoryIds": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/uuid" } },
        "mediaIds": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/uuid" } },
        "specifications": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/specification" } }
      }
    }
  }
}
