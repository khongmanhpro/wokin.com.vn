{
  "name": "wokin-com-vn",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "prebuild": "npm run build:images",
    "build:images": "node scripts/build-responsive-images.mjs",
    "build:data": "node scripts/build-catalog-data.mjs",
    "check:data": "node scripts/build-catalog-data.mjs --check",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "validate:data": "node scripts/validate-catalog.mjs",
    "validate:export": "node scripts/validate-static-export.mjs && node scripts/smoke-static-server.mjs",
    "verify": "npm run typecheck && npm test && npm run validate:data && npm run build && npm run validate:export"
  },
  "dependencies": {
    "next": "15.5.24",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "overrides": {
    "postcss": "8.5.26",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "typescript": "5.9.3"
  }
}
